# .env.example — cópialo a .env y rellena los valores reales.
#   cp .env.example .env
# NUNCA commitees .env (está en .gitignore). Este archivo (.env.example) SÍ se versiona.
#
# Nota: los MCP (Vercel / GitHub / Supabase) usan OAuth y NO necesitan nada aquí.
# Esto es solo para los secretos de runtime de TU app, cuando exista.

# --- Supabase (runtime de la app) ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # solo backend; nunca lo expongas en el cliente

# --- App ---
# DATABASE_URL=
# NODE_ENV=development
